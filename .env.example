# ==========================================
# Sala do Passado — Configuração de Ambiente
# ==========================================

# Provedor de IA (API compatível com padrão OpenAI: /v1/chat/completions)
AI_BASE_URL="http://127.0.0.1:20128/v1"
AI_API_KEY=""

# Modelos para resolução de questões e redações
AI_MODEL="ds-web/deepseek-v4-flash-think"
AI_FALLBACK_MODEL="gemini-web/gemini-3.6-flash"
AI_CLAUDE_MODEL="claude-web/claude-5-sonnet"

# Lista de modelos candidatos para fallback automático em ordem de preferência.
# Sugestões de provedores gratuitos suportados (ex: via OmniRoute):
# 1. DeepSeek Web: ds-web/deepseek-v4-flash-think (DeepSeek V4 Flash Thinking - Recomendado)
# 2. Gemini Web:   gemini-web/gemini-3.6-flash (Gemini 3.6 Flash)
# 3. Claude Web:   claude-web/claude-5-sonnet (Claude 5 Sonnet)
# 4. OpenCode:     oc/nemotron-3-ultra-free (OpenCode Free)
CANDIDATE_MODELS="ds-web/deepseek-v4-flash-think,gemini-web/gemini-3.6-flash,claude-web/claude-5-sonnet,ds-web/deepseek-chat,oc/nemotron-3-ultra-free"

# Proxy HTTP/HTTPS Opcional
# Recomendação: Utilize um proxy residencial (ou com IP brasileiro) caso a CDN da IP.TV bloqueie requisições de datacenter/IPs internacionais.
# Formato: http://usuario:senha@ip_ou_host:porta
PROXY=""

# Chave de Assinatura APIM da SED (Pública no cliente oficial SED)
SED_SUBSCRIPTION_KEY="d701a2043aa24d7ebb37e9adf60d043b"

# Configuração do Resolvedor de CAPTCHA Local
CAPTCHA_SOLVER_PYTHON="python3"
